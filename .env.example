# Public Supabase browser configuration (safe to expose, but restrict the project URL).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-side Supabase configuration.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Canonical HTTPS origin used for payment return/webhook URLs.
PUBLIC_APP_URL=https://cafe1stalbans.co.uk

# Exact 40-character Git commit deployed to production. This is public release metadata.
PUBLIC_RELEASE_SHA=replace-with-the-deployed-40-character-git-sha

# SumUp merchant integrations (server-side only).
SUMUP_API_KEY=replace-me
SUMUP_MERCHANT_CODE=replace-me
SUMUP_AFFILIATE_KEY=replace-me
# Public numeric merchant ID issued by Google Pay after cafe1stalbans.co.uk is approved.
GOOGLE_PAY_MERCHANT_ID=replace-with-google-pay-merchant-id

# At least 32 random characters; sent as: Authorization: Bearer <secret>
CRON_SECRET=replace-with-a-random-32-character-minimum-secret

# Set true after every manager has enrolled and verified a Supabase MFA factor.
REQUIRE_ADMIN_MFA=false

# Required production connector credentials. Delivery fails closed when the
# server-side Maps connection is unavailable; Resend powers receipts, auth and
# the juror claim report. Keep these in the host secret manager only.
LOVABLE_API_KEY=
RESEND_API_KEY=
GOOGLE_MAPS_API_KEY=
# Optional public browser map configuration. Restrict this key to
# https://cafe1stalbans.co.uk/* and only the required browser APIs.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=

# Localhost-only developer login. Never enable in production.
ENABLE_DEV_LOGIN=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_STAFF_EMAIL=
DEV_STAFF_PASSWORD=
DEV_DRIVER_EMAIL=
DEV_DRIVER_PASSWORD=
DEV_CUSTOMER_EMAIL=
DEV_CUSTOMER_PASSWORD=
